----
read-only

statement error
ALTER TABLE dd.logs.main RENAME TO renamed;
----
read-only

statement error
INSERT INTO dd.logs.main (body) VALUES ('not allowed');
----
read-only

statement error
UPDATE dd.logs.main SET body = 'not allowed';
----
read-only

statement error
DELETE FROM dd.logs.main;
----
read-only

statement ok
DETACH dd;

query I
SELECT count(*) FROM duckdb_tables() WHERE database_name = 'dd';
----
0

# Omitting SECRET uses the same first in-scope Datadog secret selection as the table function.
statement ok
ATTACH 'datadog:' AS dd_default (TYPE datadog, INDEXES ['main']);

query I
SELECT count(*) FROM duckdb_tables() WHERE database_name = 'dd_default' AND table_name = 'main';
----
1

# The implicit selection is pinned at ATTACH. Replacing the available secrets must not silently
# redirect this catalog to another Datadog account.
statement ok
CREATE SECRET dd_other (
    TYPE datadog,
    API_KEY 'OTHER_API_KEY_VALUE',
    APP_KEY 'OTHER_APP_KEY_VALUE'
);

statement ok
DROP SECRET dd_test;

statement error
DESCRIBE SELECT * FROM dd_default.logs.main;
----
No secret with name 'dd_test' found

statement ok
DETACH dd_default;

statement ok
DROP SECRET dd_other;

# --- read_datadog_log_stats (offline) ----------------------------------------

query I
SELECT count(*) >= 1 FROM duckdb_functions() WHERE function_name = 'read_datadog_log_stats';
----
true

# Parameters are validated before credentials are resolved.
statement error
SELECT * FROM read_datadog_log_stats(query => '*', compute => 'cardinality');
----
requires metric

statement error
SELECT * FROM read_datadog_log_stats(query => '*', group_limit => 0);
----
group_limit must be between 1 and 10000

statement error
SELECT * FROM read_datadog_log_stats(query => '*', group_by => ['']);
----
must be non-empty

statement error
SELECT * FROM read_datadog_log_stats(query => '*', timeout => 0);
----
timeout must be >= 1

# All secrets were dropped above, so binding fails with guidance (no network call).
statement error
SELECT * FROM read_datadog_log_stats(query => '*');
----
No 'datadog' secret found

# The secret accepts an intake-URL override; it is configuration, not a credential.
statement ok
CREATE SECRET dd_intake (
    TYPE datadog,
    API_KEY 'API_KEY_VALUE',
    APP_KEY 'APP_KEY_VALUE',
    INTAKE_URL 'http://127.0.0.1:55520'
);

query I
SELECT count(*) FROM duckdb_secrets() WHERE name = 'dd_intake' AND secret_string LIKE '%127.0.0.1:55520%';
----
1

statement ok
DROP SECRET dd_intake;

# --- read_datadog_traces / write_datadog_traces (offline) ---------------------

query II
SELECT count(*) FILTER (WHERE function_name = 'read_datadog_traces') >= 1,
       count(*) FILTER (WHERE function_name = 'write_datadog_traces') >= 1
FROM duckdb_functions();
----
true	true

# Named parameters are validated before credentials are resolved.
statement error
SELECT * FROM read_datadog_traces(page_size => 0);
----
page_size must be between 1 and 1000

statement error
SELECT * FROM read_datadog_traces(max_rows => -1);
----
max_rows must be >= 0

statement error
SELECT * FROM read_datadog_traces(sort => 'newest');
----
sort must be either 'timestamp' or '-timestamp'

statement error
SELECT * FROM read_datadog_traces(timeout => 0);
----
timeout must be >= 1

# All secrets were dropped above, so binding the reader fails with guidance (no network call).
statement error
SELECT * FROM read_datadog_traces();
----
No 'datadog' secret found

# The trace writer targets a (local) Datadog Agent, which needs no credentials: it binds without
# any datadog secret in scope (bind only; nothing is sent).
query I
SELECT column_type FROM (DESCRIBE SELECT write_datadog_traces({'trace_id': 'ab12', 'span_id': 'cd34'}));
----
VARCHAR

# ...but the input struct must at least identify a span.
statement error
DESCRIBE SELECT write_datadog_traces({'name': 'orphan'});
----
must contain trace_id and span_id

statement error
DESCRIBE SELECT write_datadog_traces('not a struct');
----
must be a STRUCT

# An explicitly named secret must still exist.
statement error
DESCRIBE SELECT write_datadog_traces({'trace_id': 'ab', 'span_id': 'cd'}, 'no_such_secret');
----
No secret with name 'no_such_secret' found

# The secret accepts a trace-agent override; like intake_url it is configuration, not a credential.
statement ok
CREATE SECRET dd_traces (
    TYPE datadog,
    API_KEY 'API_KEY_VALUE',
    APP_KEY 'APP_KEY_VALUE',
    TRACE_AGENT_URL 'http://127.0.0.1:8136'
);

query I
SELECT count(*) FROM duckdb_secrets() WHERE name = 'dd_traces' AND secret_string LIKE '%127.0.0.1:8136%';
----
1

# With a secret present, the reader binds and exposes the 24-column duckdb-otlp traces schema
# (bind only; the spans API is called only when the scan runs).
query I
SELECT count(*) FROM (DESCRIBE SELECT * FROM read_datadog_traces(query => '*', "from" => 'now-15m', "to" => 'now'));
----
24

query I
SELECT count(*) FROM (DESCRIBE SELECT * FROM read_datadog_traces())
WHERE column_name IN ('start_time_unix_nano', 'duration_time_unix_nano', 'trace_id', 'span_id', 'parent_span_id',
                      'service_name', 'name', 'kind', 'status_code', 'status_status_message',
                      'resource_attributes', 'span_attributes', 'events_json', 'links_json', 'flags');
----
15

query II
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM read_datadog_traces())
WHERE column_name IN ('start_time_unix_nano', 'duration_time_unix_nano', 'kind') ORDER BY column_name;
----
duration_time_unix_nano	BIGINT
kind	INTEGER
start_time_unix_nano	TIMESTAMP_NS

# Planning is network-free and surfaces the request parameters.
query II
EXPLAIN (FORMAT JSON) SELECT * FROM read_datadog_traces(sort => '-timestamp', max_rows => 50);
----
physical_plan	<REGEX>:.*"Datadog Sort": "-timestamp".*"Datadog Max Rows": "50".*

query II
EXPLAIN (FORMAT JSON) SELECT * FROM read_datadog_traces();
----
physical_plan	<REGEX>:.*"Datadog Query": "[*]".*"Datadog From": "now-15m".*"Datadog To": "now".*"Datadog Sort": "timestamp".*"Datadog Page Size": "1000".*"Datadog Max Rows": "0".*"Datadog Retries": "4".*"Datadog Timeout": "60".*

statement ok
DROP SECRET dd_traces;

# TRACE_INTAKE 'direct' sends protobuf straight to the backend trace intake (no Agent). It needs
# an API key; a secret without one fails at bind, before anything is sent.
statement ok
CREATE SECRET dd_direct_nokey (TYPE datadog, TRACE_INTAKE 'direct');

statement error
DESCRIBE SELECT write_datadog_traces({'trace_id': 'ab', 'span_id': 'cd'}, 'dd_direct_nokey');
----
requires API_KEY

statement ok
DROP SECRET dd_direct_nokey;

# An unknown mode is rejected at bind.
statement ok
CREATE SECRET dd_direct_bad (TYPE datadog, API_KEY 'k', APP_KEY 'a', TRACE_INTAKE 'proxy');

statement error
DESCRIBE SELECT write_datadog_traces({'trace_id': 'ab', 'span_id': 'cd'}, 'dd_direct_bad');
----
must be 'agent' or 'direct'

statement ok
DROP SECRET dd_direct_bad;

# The two trace destinations are mutually exclusive.
statement ok
CREATE SECRET dd_direct_conflict (
    TYPE datadog, API_KEY 'k', APP_KEY 'a',
    TRACE_INTAKE 'direct', TRACE_AGENT_URL 'http://127.0.0.1:8126'
);

statement error
DESCRIBE SELECT write_datadog_traces({'trace_id': 'ab', 'span_id': 'cd'}, 'dd_direct_conflict');
----
mutually exclusive

statement ok
DROP SECRET dd_direct_conflict;

# A well-formed direct-intake secret binds offline (bind only; nothing is sent).
statement ok
CREATE SECRET dd_direct (TYPE datadog, API_KEY 'k', APP_KEY 'a', TRACE_INTAKE 'direct');

query I
SELECT column_type FROM (DESCRIBE SELECT write_datadog_traces({'trace_id': 'ab12', 'span_id': 'cd34'}, 'dd_direct'));
----
VARCHAR

statement ok
DROP SECRET dd_direct;
